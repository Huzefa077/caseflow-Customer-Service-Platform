// WHAT: the database blueprint — tables (models), their columns, and enums.
// WHY:  Prisma reads it to create tables (`npx prisma migrate dev`) and to
//       generate TypeScript code (`npx prisma generate`). Re-run both after changes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEAM_LEAD
  AGENT
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(AGENT)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("users")
}
