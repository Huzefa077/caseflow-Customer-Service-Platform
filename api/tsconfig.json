// WHAT: settings for TypeScript — where my code is (src), where compiled JS goes (dist), how strict to be.
// WHY:  so TypeScript checks my code the same way every time.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
